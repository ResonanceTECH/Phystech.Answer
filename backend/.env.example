# Порт HTTP-сервера
PORT=8080

# URL ML-сервиса (POST /ask для вопросов по регламентам)
ML_SERVICE_URL=http://localhost:8000

# Разрешённый origin для CORS (на проде — домен фронтенда)
CORS_ORIGIN=*

# Папка с документами базы знаний: импортируется при старте (повторы по SHA-256 пропускаются)
DOCS_DIR=../ml/data/documents

# Синтетические демо-документы (только для разработки UI). Реальная база — DOCS_DIR.
SEED_DEMO_DATA=false

# PostgreSQL. Спецсимволы пароля URL-энкодить ('#' -> %23, '!' можно не кодировать).
DATABASE_URL=postgresql://fiztech_admin:CHANGE_ME@localhost:5432/fiztech_answer
