# Порт HTTP-сервера
PORT=8080

# URL ML-сервиса (POST /ask для вопросов по регламентам)
ML_SERVICE_URL=http://localhost:8000

# Разрешённые origins для CORS, через запятую (cookie-сессии не работают с '*').
# В dev через Vite-proxy CORS не нужен — origin совпадает.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Засеять демо-данные при старте (true/false)
SEED_DEMO_DATA=true

# PostgreSQL. Спецсимволы пароля URL-энкодить ('#' -> %23, '!' можно не кодировать).
DATABASE_URL=postgresql://fiztech_admin:CHANGE_ME@localhost:5432/fiztech_answer

# ── Авторизация и почта ──────────────────────────────────────────────
# SMTP для писем восстановления пароля. В dev — Mailpit (docker compose).
# Без SMTP_HOST письма логируются, но не отправляются.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Физтех.Ответ <no-reply@phystech.answer>

# Публичный URL фронтенда — в него ведут ссылки в письмах.
# https:// здесь также включает флаг Secure у session-cookie.
APP_PUBLIC_URL=http://localhost:5173

# TTL сессии без «Запомнить меня» / с ним (часы).
SESSION_TTL_HOURS=72
REMEMBER_TTL_HOURS=720

# Срок жизни ссылки восстановления пароля (минуты).
PASSWORD_RESET_TTL_MINUTES=20

# Ограничить регистрацию доменом почты (пусто — любой).
# ALLOWED_EMAIL_DOMAIN=mipt.ru
