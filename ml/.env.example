# Порт HTTP-сервера ML-сервиса
PORT=8000

# LLM (OpenAI-совместимый API): генерация ответа, реранкинг, декомпозиция.
# Локальный Ollama: http://localhost:11434/v1. "off" — без LLM (ответ выдержками).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:4b
# none — отключить «размышления» гибридных моделей (быстрее в разы)
LLM_REASONING_EFFORT=none

# Эмбеддинги. "off" — только BM25.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3

# Снимок индекса
INDEX_PATH=index.json

# Конвейер поиска
# RAG_MODE: bm25 | vector | hybrid; RERANK — LLM-реранкинг кандидатов;
# DECOMPOSE — разбиение составных вопросов; AMENDMENTS — изменяющие акты
RAG_MODE=hybrid
RAG_RERANK=true
RAG_DECOMPOSE=true
RAG_AMENDMENTS=true
RAG_TOP_K=6
RAG_MIN_VECTOR=0.47
RAG_MIN_BM25=10

CORS_ORIGIN=*
