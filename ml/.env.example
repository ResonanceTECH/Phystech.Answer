# Порт HTTP-сервера ML-сервиса
PORT=8000

# LLM для генерации ответов (OpenAI-compatible API).
# Ollama: http://localhost:11434/v1, модель например qwen2.5:7b.
# "off" — отключить LLM, отвечать будет экстрактами найденных фрагментов.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b

# Эмбеддинги для векторного поиска (OpenAI-compatible API).
# Ollama: http://localhost:11434/v1, модель nomic-embed-text.
# "off" — отключить, поиск будет лексическим (без учёта смысла).
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text

# Файл снимка индекса (сохраняется при переиндексации)
INDEX_PATH=index.json

# Параметры поиска
RAG_TOP_K=8
RAG_MIN_SCORE=0.25

# Разрешённый origin для CORS
CORS_ORIGIN=*
