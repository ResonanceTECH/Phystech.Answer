# Конфигурация docker-compose. Скопируйте в .env при необходимости
# переопределить дефолты (compose работает и без .env).

# Пароль PostgreSQL — используется и в DATABASE_URL backend'а.
# Берите буквы/цифры: спецсимволы нужно URL-энкодить ('#' -> %23).
POSTGRES_PASSWORD=fiztech_dev_hack

# Засеять демо-данные при старте backend (true/false)
SEED_DEMO_DATA=true

# LLM и эмбеддинги для ml-сервиса (OpenAI-compatible API).
# Дефолт — Ollama на хост-машине (host.docker.internal работает в
# Docker Desktop; на Linux проброшен через extra_hosts).
# "off" — деградированный режим: лексический поиск + ответы-экстракты.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text

# Параметры поиска
RAG_TOP_K=8
RAG_MIN_SCORE=0.25

# Vite build-args для frontend (подставляются в клиентскую сборку).
# VITE_API_URL не задаём — в compose API идёт через nginx на /api.
VITE_APP_NAME=Физтех.Ответ
VITE_DEMO_MODE=true
VITE_ENABLE_ADMIN=true
