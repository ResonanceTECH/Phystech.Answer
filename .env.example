# Конфигурация docker-compose. Скопируйте в .env при необходимости
# переопределить дефолты (compose работает и без .env).

# Пароль PostgreSQL — используется и в DATABASE_URL backend'а.
# Берите буквы/цифры: спецсимволы нужно URL-энкодить ('#' -> %23).
POSTGRES_PASSWORD=fiztech_dev_hack

# Засеять демо-данные при старте backend (true/false)
SEED_DEMO_DATA=true

# ---------- Инференс (llama.cpp на хосте) ----------
# По умолчанию ml ждёт три llama-server на хост-машине
# (host.docker.internal работает в Docker Desktop и OrbStack):
#   :8081 — чат (Qwen3.5-4B GGUF), :8082 — эмбеддинги, :8083 — реранкер.
# Запуск на хосте — см. ml/models/ и README ml/.
# "off" в любом *_BASE_URL — отключить компонент (деградированный режим).
LLM_BASE_URL=http://host.docker.internal:8081/v1
LLM_API_KEY=
LLM_MODEL=local
LLM_DISABLE_THINKING=true

EMBED_BASE_URL=http://host.docker.internal:8082/v1
EMBED_API_KEY=
EMBED_MODEL=local

RERANK_BASE_URL=http://host.docker.internal:8083/v1
RERANK_API_KEY=
RERANK_MODEL=local
RERANK_ENABLED=true

# Параметры поиска
RAG_TOP_K=8
RAG_MIN_SCORE=0.05

# Таймаут backend -> ml для /api/ask (сек). LLM-генерация долгая —
# держите ниже WriteTimeout ml-сервиса (180s).
# ML_TIMEOUT_SECONDS=170

# ---------- Почта (backend, forgot-password) ----------
# Пустой SMTP_HOST — отправка писем отключена.
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Физтех.Ответ <no-reply@phystech.answer>

# Публичный URL приложения — для ссылок в письмах.
# APP_PUBLIC_URL=http://localhost:3000
# ALLOWED_EMAIL_DOMAIN=phystech.edu   # ограничить домен почты при регистрации

# Vite build-args для frontend (подставляются в клиентскую сборку).
# VITE_API_URL не задаём — в compose API идёт через nginx на /api.
VITE_APP_NAME=Физтех.Ответ
VITE_DEMO_MODE=true
VITE_ENABLE_ADMIN=true
