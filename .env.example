# Пароль fiztech_admin (Postgres). Без символов # @ / ? : либо URL-энкодить.
DB_PASSWORD=CHANGE_ME

# --- Генерация ответов (OpenAI-совместимый API) ---
# По умолчанию (пусто) — локальная модель qwen2.5:3b в контейнере ollama,
# данные не покидают контур. Пример внешнего API (только для открытых данных):
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=<ключ>
# LLM_MODEL=gpt-oss:120b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

