# Конфигурация docker compose. Файл НЕ обязателен: compose работает на
# значениях по умолчанию. Скопируйте в .env, чтобы что-то переопределить.

# Пароль PostgreSQL — используется и в DATABASE_URL backend'а.
# Берите буквы/цифры: спецсимволы нужно URL-энкодить ('#' -> %23).
POSTGRES_PASSWORD=fiztech_dev_hack

# Порты на хосте (если заняты — поменяйте)
# FRONTEND_PORT=3000
# API_PORT=8080
# ML_PORT=8000
# DB_PORT=5432

# --- Генерация ответов (OpenAI-совместимый API) ---
# По умолчанию — Qwen 3.5 4B в контейнере ollama: данные не покидают контур.
# Внешний API допустим только для открытых данных, например:
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=<ключ>
# LLM_MODEL=gpt-oss:120b
# Ускорение на Mac/GPU: Ollama на хосте
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# EMBED_BASE_URL=http://host.docker.internal:11434/v1
# LLM_REASONING_EFFORT=none

# --- Конвейер поиска ---
# RAG_MODE=hybrid            # bm25 | vector | hybrid
# RAG_RERANK=decision        # decision (H2O-Lightning) | llm | off
# DECIDER_QUANT=Q4_K_M       # квантизация H2O-Lightning: Q4_K_M (CPU) | Q8_0 (точнее)
# DECISION_BASE_URL=http://host.docker.internal:8090   # llama-server на хосте (Metal/GPU)
# RAG_DECOMPOSE=true         # разбиение составных вопросов
# RAG_AMENDMENTS=true        # подтягивать изменяющие акты

# Синтетические демо-документы (только для разработки UI)
# SEED_DEMO_DATA=false

# Build-args фронтенда
# VITE_APP_NAME=Физтех.Ответ
