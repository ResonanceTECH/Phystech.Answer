# Конфигурация docker compose. Файл НЕ обязателен: compose работает на
# значениях по умолчанию. Скопируйте в .env, чтобы что-то переопределить.

# Пароль PostgreSQL — используется и в DATABASE_URL backend'а.
# Берите буквы/цифры: спецсимволы нужно URL-энкодить ('#' -> %23).
POSTGRES_PASSWORD=fiztech_dev_hack

# Порты на хосте (если заняты — поменяйте)
# FRONTEND_PORT=3000
# API_PORT=8080
# ML_PORT=8000
# DB_PORT=5432
# MAILPIT_PORT=8025

# ---------- Инференс ----------
# По умолчанию модели работают в контейнерах llm / embed / rerank (llama.cpp,
# CPU) — данные не покидают контур. Ускорение на GPU / Apple Silicon:
# запустите llama-server на хосте (см. ml/README.md) и укажите:
# LLM_BASE_URL=http://host.docker.internal:8081/v1
# EMBED_BASE_URL=http://host.docker.internal:8082/v1
# RERANK_BASE_URL=http://host.docker.internal:8083/v1
#
# Внешний OpenAI-совместимый API допустим только для открытых данных:
# LLM_BASE_URL=https://example-provider/v1
# LLM_API_KEY=<ключ>
# LLM_MODEL=<модель>
#
# "off" в любом *_BASE_URL — отключить компонент (деградированный режим).
# LLM_DISABLE_THINKING=true
# RERANK_ENABLED=true
# RAG_TOP_K=8
# RAG_MIN_SCORE=0.05

# ---------- Почта (backend, восстановление пароля) ----------
# По умолчанию письма перехватывает Mailpit: http://localhost:8025
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Физтех.Ответ <no-reply@phystech.answer>

# Публичный URL приложения — для ссылок в письмах; https:// включает Secure-cookie.
# APP_PUBLIC_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000
# ALLOWED_EMAIL_DOMAIN=phystech.edu   # ограничить домен почты при регистрации

# Синтетические демо-документы (только для разработки UI)
# SEED_DEMO_DATA=false

# Build-args фронтенда
# VITE_APP_NAME=Физтех.Ответ
# VITE_DEMO_MODE=true
