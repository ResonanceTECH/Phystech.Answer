# Базовый URL API. По умолчанию запросы идут на /api и проксируются
# Vite на Go-backend http://localhost:8080 (см. server.proxy в vite.config.ts).
# VITE_API_URL=http://localhost:8080/api

# Название приложения в шапке и сайдбаре.
# VITE_APP_NAME=Физтех.Ответ

# Демо-режим: бейдж «Демо» в шапке (авторизации пока нет).
# VITE_DEMO_MODE=true

# Показывать раздел «Администрирование» в навигации.
# Разграничение прав должно обеспечиваться backend — сейчас его нет.
# VITE_ENABLE_ADMIN=true
